# API Gateway Environment Variables (Dummy Values)
# Rename this file to .env and place it in the appropriate directory (e.g., /docker) before running docker-compose.

# ---------------------------------------------------------
# API Gateway Host & Image Config
# ---------------------------------------------------------
GATEWAY_HOST_IP=10.0.0.50
GATEWAY_HOST_PORT=8888
APIGW_VERSION=v1.2.3

# ---------------------------------------------------------
# Keycloak Security & Authentication
# ---------------------------------------------------------
KEYCLOAK_CLIENT_SECRET=superSecretDummyString123!@#
KEYCLOAK_ISSUER_URI=https://dummy.example.com/keycloak/realms/dummyrealm
KEYCLOAK_ADMIN_USER=sysadmin_dummy
KEYCLOAK_ADMIN_PASSWORD=secure_password_dummy
KEYCLOAK_HOSTNAME=https://dummy.example.com/keycloak

# ---------------------------------------------------------
# Jenkins CI/CD Container Config
# ---------------------------------------------------------
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_HOST_PORT=9090

# ---------------------------------------------------------
# Internal Docker Network URLs
# ---------------------------------------------------------
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=dummyrealm
JENKINS_INTERNAL_URL=http://jenkins:8080
